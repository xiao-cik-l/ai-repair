# ============================================================
# 学生公寓报修系统 —— 环境变量配置文件
# 复制本文件为 .env 并填入真实值
# ============================================================

FLASK_SECRET_KEY=please-change-this-secret
CODE_EXPIRE_MINUTES=5
ADMIN_TIME_KEY_SECRET=ADMIN-DEMO-SECRET-2026
ADMIN_KEY_EXPIRE_SECONDS=120

# ============================================================
# ★★★ QQ 邮箱 SMTP 配置（必填）★★★
#
# SMTP_HOST：固定为 smtp.qq.com
# SMTP_PORT：固定为 465
# SMTP_USER：★★★ 改成你的 QQ 邮箱地址，如 123456789@qq.com ★★★
# SMTP_PASSWORD：★★★ 改成你的 QQ 邮箱授权码（非 QQ 登录密码！）★★★
#   获取方式：QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 开启 → 生成授权码
# SMTP_SENDER：发件人地址，通常与 SMTP_USER 相同
# ============================================================
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASSWORD=你的QQ邮箱授权码
SMTP_SENDER=你的QQ邮箱@qq.com

# ============================================================
# ★★★ AI 模块（正式版新增）★★★
#
# DASHSCOPE_API_KEY：阿里云百炼的 API Key（2026 年新版形如 sk-ws-...）。
#   对话模型（deepseek-v4-pro-0813）和向量模型（text-embedding-v3）共用这一把。
#   ⚠ 模型名必须写快照全名（带日期），别名和快照是两条免费额度池：
#     写别名 deepseek-v4-pro 即使控制台显示有额度也会报 403（2026-10-24 实测）。
#   获取方式：阿里云百炼控制台 → API-KEY 管理 → 创建
#   可选覆盖（不填则用 config.py 默认值）：LLM_MODEL / LLM_FALLBACK_MODEL /
#   LLM_ENABLE_THINKING / LLM_BASE_URL
#   注意：代码里只读环境变量、不写兜底值，缺失时分类和建单会在调用瞬间报错。
#   本机已设过用户级环境变量的话，这里可以不填。
# ============================================================
DASHSCOPE_API_KEY=sk-ws-你的百炼APIKey
