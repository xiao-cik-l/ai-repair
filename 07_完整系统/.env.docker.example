# ============================================================
# 容器部署用环境变量模板
# 用法：复制一份改名为 .env，放在 docker-compose.yml 同目录
#   cp .env.docker.example .env
# compose 启动时会自动读它。
# ============================================================

# 数据库 root 密码（容器内部使用，不对外暴露 3306 端口）
MYSQL_ROOT_PASSWORD=change-this-root-pwd
MYSQL_DB=cjl_505

# 宿主机端口，被占用时改成 5001 之类
WEB_PORT=5000

# 大模型 Key（百炼，sk- 或 sk-ws- 开头）。不填则 AI 助手会返回调用失败，
# 普通报修流程不受影响。
DASHSCOPE_API_KEY=

# 百炼的免费额度按「模型快照」独立发放：写别名会 403。
# 平台下线该快照时改这里，不用改代码。
LLM_MODEL=deepseek-v4-pro-0813
LLM_FALLBACK_MODEL=qwen-turbo

# 发验证码用的 QQ 邮箱。SMTP_USER 同时是演示账号的邮箱，
# 登录时填的邮箱必须与它一致，否则会提示「学号、邮箱或密码错误」。
SMTP_USER=
SMTP_PASSWORD=

# 没有邮箱授权码又想演示登录时，设为 1：验证码会打印在容器日志里，
# 用 docker compose logs -f web 就能看到。
DEMO_LOGIN_CODE=0

# Flask 会话签名密钥，正式用必须换掉
FLASK_SECRET_KEY=change-me-before-deploy
